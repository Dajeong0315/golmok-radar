# 이 파일을 복사해 backend/.env 를 만들고 실제 값을 넣으세요. (.env 는 Git에 올리지 않습니다)

# 서울 열린데이터광장 Open API 인증키 (길단위인구 수집, 새 분기 점포·추정매출 수집용)
SEOUL_OPEN_API_KEY=

# 기본 기준분기 고정 (선택). 비우면 DB에 적재된 가장 최근 분기를 씁니다. 예: 20254
DEFAULT_QUARTER=

# 한국부동산원 R-ONE Open API 인증키 (Phase 12 임대 벤치마크 수집용)
RONE_API_KEY=

# 공공데이터포털 데이터셋 15125364 활용신청 후 받은 일반 인증키(Decoding)
# K-Startup 지원사업 공고 Open API 인증키 (Phase 13 공식 공고 후보용)
K_STARTUP_API_KEY=

# Supabase 연결 정보 (Session pooler). Supabase가 제공하는 postgresql:// URL을 그대로 사용할 수 있습니다.
# 비밀번호의 특수문자는 URL 인코딩하고 SSL 옵션은 Supabase 안내값을 유지하세요.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require
# 테스트 DB는 backend/.env.test에 같은 DATABASE_URL 변수로 넣고,
# GOLMOK_ENV=test로 백엔드/Alembic을 실행합니다. (.env.test도 Git에 올리지 않습니다.)

# 프런트엔드 주소 허용(CORS). JSON 배열로, 주소 끝에 / 를 붙이지 않고, 같은 이름의 줄은 하나만 둡니다.
# 로컬 개발: CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# 운영 서버(Lightsail): CORS_ORIGINS=["https://golmok-radar.axworks.site"]
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 리뷰 수집 원문 암호화 키(Fernet). 아래 명령으로 만든 값을 넣고 Git에 올리지 않습니다.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 서버에서 키를 바꾸면 이전에 보관한 암호문은 읽을 수 없습니다.
REVIEW_CAPTURE_ENCRYPTION_KEY=

# 리뷰 수집 브라우저 경로(선택). 비우면 PC는 설치된 Chrome·Edge를, 서버는 `playwright install chromium`으로 받은 브라우저를 씁니다.
REVIEW_CAPTURE_BROWSER_PATH=

# 로그인 확인(SUPABASE_URL·ANON_KEY), 회원 탈퇴(SERVICE_ROLE 또는 SECRET 키 + KAKAO_ADMIN_KEY),
# 리뷰 비교의 카카오 장소 확인(KAKAO_REST_API_KEY)에 씁니다. 서버 준비 상태는 `python -m app.env_check`로 확인합니다.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
KAKAO_ADMIN_KEY=
KAKAO_REST_API_KEY=
