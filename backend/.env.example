# 이 파일을 복사해 backend/.env 를 만들고 실제 값을 넣으세요. (.env 는 Git에 올리지 않습니다)

# 서울 열린데이터광장 Open API 인증키 (길단위인구-상권 수집용)
SEOUL_OPEN_API_KEY=

# Supabase 연결 정보 (Session pooler) — 교안 06 DB 연동 단계에서 채움
# DATABASE_URL=
# TEST_DATABASE_URL=

# 로컬 React 개발 서버. 여러 주소는 JSON 배열로 작성합니다.
# CORS_ORIGINS=["http://localhost:5173"]
